# Cloudflare headers. Extension-specific rules for feeds so .ics and .xml don't
# share one wildcard match — Cloudflare merges headers on overlapping rules
# rather than overriding.
#
# This file must never be written with a UTF-8 BOM. PowerShell's Out-File adds
# one and Cloudflare then treats the first rule as malformed.

/data/schedule/*
  Cache-Control: public, max-age=1800

# Crests get replaced — a school rebrands, or a supplier's white box gets
# knocked out. A week-long cache meant browsers kept showing the old file long
# after the new one shipped, so these revalidate against the ETag instead:
# cheap 304s, and a change is visible on the next load rather than in a week.
/images/logos/*
  Cache-Control: public, max-age=300, must-revalidate

# Stable once published. Note there is deliberately NO /images/* rule:
# Cloudflare MERGES overlapping rules rather than letting the more specific one
# win, so a catch-all would append its own max-age to every line above and the
# first value would take effect instead of the intended one.
/images/photos/*
  Cache-Control: public, max-age=604800

/images/icons/*
  Cache-Control: public, max-age=604800

/images/sponsors/*
  Cache-Control: public, max-age=604800

/images/videos/*
  Cache-Control: public, max-age=604800

/feeds/all.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/schools/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/schools/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/sports/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/sports/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/teams/*
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800
